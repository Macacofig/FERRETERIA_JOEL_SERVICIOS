# =============================================================================
# FERRETERÍA JOEL — Plantilla de variables de entorno (copiar a .env)
# =============================================================================

# --- Base de datos MySQL ---
MYSQL_ROOT_PASSWORD=cambiar_esta_contraseña
MYSQL_DATABASE=bdferreteria
MYSQL_PUERTO_HOST=3307

# --- JWT (para autenticación en los microservicios) ---
Jwt__Key=cambiar_por_una_clave_secreta_muy_larga_de_almenos_32_caracteres
Jwt__Issuer=FerreteriaJoel
Jwt__Audience=FerreteriaJoel

# --- Puerto de los servicios (host) ---
SERVICIO_VENTAS_PUERTO=5071
SERVICIO_USUARIOS_PUERTO=5072
SERVICIO_REPORTES_PUERTO=5073

# --- SMTP (requerido para enviar activaciones reales) ---
Smtp__Host=smtp.ejemplo.com
Smtp__Puerto=587
Smtp__Usuario=usuario@ejemplo.com
Smtp__Clave=usar_contrasena_de_aplicacion
Smtp__UsarSsl=true
Smtp__Remitente=usuario@ejemplo.com
Smtp__RemitenteNombre=Ferreteria Joel
