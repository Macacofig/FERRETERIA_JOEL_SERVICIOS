@page
@model FERRETERIA__Joel.Pages.ReportesModel
@{
    ViewData["Title"] = "Reportes";
}

<div class="fj-container fj-page-products">
    <section class="fj-page-head">
        <p class="fj-eyebrow">Administración · Reportes</p>
        <h1>Reportes y estadísticas</h1>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.Mensaje))
    {
        <div class="fj-alert" role="alert"><span>@Model.Mensaje</span></div>
    }

    <div class="fj-card">
        <div class="fj-tabs" role="tablist">
            <button type="button" class="fj-btn fj-btn-primary" id="tabProductos" role="tab" aria-selected="true">Reporte 1: Productos</button>
            <button type="button" class="fj-btn fj-btn-ghost" id="tabVentas" role="tab" aria-selected="false">Reporte 2: Ventas por producto</button>
        </div>

        <section id="seccionProductos" class="fj-form" style="margin-top:16px;">
            <h2>Productos de stock estable y precio razonable</h2>
            <form method="post" class="fj-form-grid">
                <div class="fj-form-field">
                    <label class="fj-form-label">Precio mínimo (Bs.)</label>
                    <input class="fj-input" asp-for="PrecioMinimo" type="number" min="0" step="0.01" />
                </div>
                <div class="fj-form-field">
                    <label class="fj-form-label">Precio máximo (Bs.)</label>
                    <input class="fj-input" asp-for="PrecioMaximo" type="number" min="0" step="0.01" />
                </div>
                <div class="fj-form-field">
                    <label class="fj-form-label">Cantidad vendida mínima</label>
                    <input class="fj-input" asp-for="CantidadVendidaMinima" type="number" min="0" />
                </div>
                <div class="fj-form-actions fj-form-field--full">
                    <button class="fj-btn fj-btn-primary" asp-page-handler="ConsultarProductos">Consultar</button>
                </div>
            </form>

            @if (Model.Productos.Count > 0)
            {
                <div style="overflow-x:auto;margin-top:16px;">
                    <table class="table">
                        <thead><tr><th>Código de producto</th><th>Nombre</th><th>Costo unitario</th><th>Descripción</th><th>Marca</th><th>Categoría</th></tr></thead>
                        <tbody>
                        @foreach (var producto in Model.Productos)
                        {
                            <tr>
                                <td>@producto.Codigo</td><td>@producto.Nombre</td><td>@producto.CostoUnitario.ToString("N2") Bs.</td>
                                <td>@producto.Descripcion</td><td>@producto.Marca</td><td>@producto.Categoria</td>
                            </tr>
                        }
                        </tbody>
                        <tfoot><tr><td colspan="6"><strong>Total de productos listados: @Model.Productos.Count</strong></td></tr></tfoot>
                    </table>
                </div>
                <form method="post" class="fj-form-actions" style="margin-top:12px;">
                    <button class="fj-btn fj-btn-primary" asp-page-handler="ProductosPdf">Generar PDF</button>
                    <button class="fj-btn fj-btn-ghost" asp-page-handler="ProductosExcel">Exportar a Excel</button>
                </form>
            }
        </section>

        <section id="seccionVentas" class="fj-form" style="margin-top:16px;display:none;">
            <h2>Ventas por producto</h2>
            <form method="post" class="fj-form-grid">
                <div class="fj-form-field">
                    <label class="fj-form-label">Fecha de inicio</label>
                    <input class="fj-input" asp-for="Desde" type="date" />
                </div>
                <div class="fj-form-field">
                    <label class="fj-form-label">Fecha de fin</label>
                    <input class="fj-input" asp-for="Hasta" type="date" />
                </div>
                <div class="fj-form-field">
                    <label class="fj-form-label">Método de pago</label>
                    <select class="fj-input" asp-for="MetodoPago">
                        <option value="Efectivo">Efectivo</option>
                        <option value="Tarjeta">Tarjeta</option>
                        <option value="QR/Transferencia">QR/Transferencia</option>
                    </select>
                </div>
                <div class="fj-form-actions fj-form-field--full">
                    <button class="fj-btn fj-btn-primary" asp-page-handler="ConsultarVentas">Consultar</button>
                </div>
            </form>

            @if (Model.VentasProducto.Count > 0)
            {
                <div style="overflow-x:auto;margin-top:16px;">
                    <table class="table">
                        <thead><tr><th>Nombre de producto</th><th>Cantidad</th><th>Total vendido</th></tr></thead>
                        <tbody>
                        @foreach (var venta in Model.VentasProducto)
                        {
                            <tr><td>@venta.Nombre</td><td>@venta.Cantidad</td><td>@venta.TotalProducto.ToString("N2") Bs.</td></tr>
                        }
                        </tbody>
                        <tfoot><tr><td colspan="2"><strong>Total general</strong></td><td><strong>@Model.VentasProducto.Sum(v => v.TotalProducto).ToString("N2") Bs.</strong></td></tr></tfoot>
                    </table>
                </div>
                <div style="display:flex;gap:24px;align-items:center;flex-wrap:wrap;margin-top:16px;">
                    <div role="img" aria-label="Gráfico de torta por producto" style="width:220px;height:220px;border-radius:50%;background:@Model.TortaCss;"></div>
                    <div>
                        @foreach (var venta in Model.VentasProducto)
                        {
                            var porcentaje = Model.VentasProducto.Sum(v => v.TotalProducto) == 0
                                ? 0
                                : venta.TotalProducto / Model.VentasProducto.Sum(v => v.TotalProducto) * 100;
                            <div><strong>@venta.Nombre:</strong> @porcentaje.ToString("N1")%</div>
                        }
                    </div>
                </div>
                <form method="post" class="fj-form-actions" style="margin-top:12px;">
                    <button class="fj-btn fj-btn-primary" asp-page-handler="VentasPdf">Generar PDF</button>
                    <button class="fj-btn fj-btn-ghost" asp-page-handler="VentasExcel">Exportar a Excel</button>
                </form>
            }
        </section>
    </div>
</div>

@section Scripts {
<script>
const productos = document.getElementById("tabProductos");
const ventas = document.getElementById("tabVentas");
const seccionProductos = document.getElementById("seccionProductos");
const seccionVentas = document.getElementById("seccionVentas");
productos.addEventListener("click", () => {
    seccionProductos.style.display = "block"; seccionVentas.style.display = "none";
    productos.classList.add("fj-btn-primary"); productos.classList.remove("fj-btn-ghost");
    ventas.classList.add("fj-btn-ghost"); ventas.classList.remove("fj-btn-primary");
});
ventas.addEventListener("click", () => {
    seccionVentas.style.display = "block"; seccionProductos.style.display = "none";
    ventas.classList.add("fj-btn-primary"); ventas.classList.remove("fj-btn-ghost");
    productos.classList.add("fj-btn-ghost"); productos.classList.remove("fj-btn-primary");
});
</script>
}
