@page
@model FERRETERIA_Web.Pages.CambiarPasswordModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<div class="container py-4" style="max-width: 620px;">
    <h1>Cambiar contraseña</h1>

    @if (!string.IsNullOrWhiteSpace(Model.Mensaje))
    {
        <div class="alert alert-success" role="status">@Model.Mensaje</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger" role="alert">@Model.Error</div>
    }

    <form method="post" class="card card-body">
        <div class="mb-3">
            <label class="form-label" asp-for="Solicitud.PasswordActual">Contraseña actual</label>
            <input class="form-control" asp-for="Solicitud.PasswordActual" type="password" autocomplete="current-password" required />
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Solicitud.PasswordNueva">Contraseña nueva</label>
            <input class="form-control" asp-for="Solicitud.PasswordNueva" type="password" autocomplete="new-password" required />
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Solicitud.PasswordConfirmacion">Confirmar contraseña nueva</label>
            <input class="form-control" asp-for="Solicitud.PasswordConfirmacion" type="password" autocomplete="new-password" required />
        </div>
        <button type="submit" class="btn btn-primary">Guardar contraseña</button>
    </form>
</div>
