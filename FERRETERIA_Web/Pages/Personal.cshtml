@page
@model FERRETERIA_Web.Pages.PersonalModel
@{
    ViewData["Title"] = "Personal";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <p class="text-muted mb-1">Módulo · Personal</p>
            <h1>Personal</h1>
        </div>
        <a asp-page="/NuevoUsuario" class="btn btn-primary">Nuevo usuario</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Mensaje))
    {
        <div class="alert alert-success" role="status">@Model.Mensaje</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger" role="alert">@Model.Error</div>
    }

    <div class="card">
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th>Nombre completo</th>
                        <th>Usuario</th>
                        <th>Correo</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Personal.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No hay personal registrado.</td></tr>
                    }
                    else
                    {
                        @foreach (var usuario in Model.Personal)
                        {
                            <tr>
                                <td>@usuario.NombreCompleto</td>
                                <td>@usuario.NombreUsuario</td>
                                <td>@usuario.Correo</td>
                                <td>@usuario.Rol</td>
                                <td>@(usuario.Activo ? "Activo" : "Inactivo")</td>
                                <td>
                                    @if (usuario.Activo)
                                    {
                                        <form method="post" asp-page-handler="DarDeBaja" class="d-inline">
                                            <input type="hidden" name="id" value="@usuario.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('¿Desea dar de baja a este usuario?');">
                                                Dar de baja
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
